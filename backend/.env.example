# Configuración del Servidor
PORT=3000
MONGO_URI=mongodb://localhost:27017/silent_help

# Configuración de TextBee (Reemplazo de Twilio)
# Obtén estas claves en https://textbee.dev
TEXTBEE_API_KEY=pon_tu_api_key_aqui
TEXTBEE_DEVICE_ID=pon_tu_device_id_aqui

# Configuración de Twilio (Obsoleta / Opcional si usas TextBee)
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=placeholder
TWILIO_VERIFY_SERVICE_SID=placeholder
